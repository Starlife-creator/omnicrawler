# === Python ===
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.whl
.python-version

# === Build Artifacts (禁止入库) ===
# 所有构建产物在 artifacts/ 版本化目录，详见 artifacts/README.md
# 用 artifacts/** 而非 artifacts/：后者整目录忽略会阻止 git 进入，导致下方 ! 放行失效
artifacts/**
# 放行构建产物说明文档，使其纳入版本控制（协作者 clone 可见构建规则与版本来源）
!artifacts/README.md
dist/
build/
build_cache/
build_dist/
release/
.omnicra/
.runtime/
_internal/
browsers/
/runtime/
_empty_*/
*.spec.bak
*.manifest

# === Testing & Coverage ===
.pytest_cache/
.test-tmp/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
cov_html/
cov_baseline.txt
e2e-artifacts/
test-results/
.pytest_session/

# === Linting & Type-Checking ===
.mypy_cache/
.ruff_cache/

# === IDE / OS ===
.vscode/
.idea/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# === Tool Data (项目级) ===
.workbuddy/
.reasonix/
.omnicrawler/
.uploads/

# === Runtime Data (运行期产出) ===
data/input/*
!data/input/.gitkeep
data/pdfs/*
!data/pdfs/.gitkeep
work/*
!work/.gitkeep
output/*
!output/.gitkeep
*.sqlite3
*.sqlite3-*
tmp/

# === Environment & Secrets ===
.env
.env.*

# === Logs ===
*.log

# === Docker ===
docker-compose.override.yml
.omnicrawl_monitor/
tmp_es.json
